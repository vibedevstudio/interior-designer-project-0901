---
import Icon from './Icon.astro';
import { site, navLinks, services } from '../data/site';

const year = new Date().getFullYear();

const socials = [
  { icon: 'instagram', href: site.social.instagram, label: 'Instagram' },
  { icon: 'facebook', href: site.social.facebook, label: 'Facebook' },
  { icon: 'linkedin', href: site.social.linkedin, label: 'LinkedIn' },
];
---

<footer class='bg-neutral-900 pt-16 text-neutral-400'>
  <div class='mx-auto grid max-w-7xl gap-12 px-6 pb-12 md:grid-cols-2 lg:grid-cols-4'>
    <!-- Brand -->
    <div>
      <a href='#home' class='font-display text-2xl font-semibold text-white'>Aikya<span class='text-primary-light'>.</span></a>
      <p class='mt-4 text-sm leading-relaxed'>
        {site.tagline}. A Kolkata interior design studio crafting residential and commercial spaces since 2013.
      </p>
      <div class='mt-6 flex gap-3'>
        {socials.map((s) => (
          <a href={s.href} target='_blank' rel='noopener noreferrer' aria-label={s.label} class='rounded-full border border-white/15 p-2.5 text-neutral-300 transition hover:border-primary hover:bg-primary hover:text-white'>
            <Icon name={s.icon} class='h-4 w-4' />
          </a>
        ))}
      </div>
    </div>

    <!-- Quick links -->
    <nav aria-label='Quick links'>
      <h3 class='mb-5 text-xs font-bold uppercase tracking-[0.25em] text-white'>Quick Links</h3>
      <ul class='space-y-2.5 text-sm'>
        {navLinks.map((link) => (
          <li><a href={link.href} class='transition hover:text-secondary'>{link.label}</a></li>
        ))}
        <li><a href='#contact' class='transition hover:text-secondary'>Contact</a></li>
      </ul>
    </nav>

    <!-- Services -->
    <div>
      <h3 class='mb-5 text-xs font-bold uppercase tracking-[0.25em] text-white'>Services</h3>
      <ul class='space-y-2.5 text-sm'>
        {services.map((service) => (
          <li><a href='#services' class='transition hover:text-secondary'>{service.title}</a></li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h3 class='mb-5 text-xs font-bold uppercase tracking-[0.25em] text-white'>Contact</h3>
      <ul class='space-y-3.5 text-sm'>
        <li class='flex items-start gap-3'>
          <Icon name='map-pin' class='mt-0.5 h-4 w-4 shrink-0 text-primary-light' />
          <span>{site.address}</span>
        </li>
        <li class='flex items-center gap-3'>
          <Icon name='phone' class='h-4 w-4 shrink-0 text-primary-light' />
          <a href={site.phoneHref} class='transition hover:text-secondary'>{site.phone}</a>
        </li>
        <li class='flex items-center gap-3'>
          <Icon name='mail' class='h-4 w-4 shrink-0 text-primary-light' />
          <a href={'mailto:' + site.email} class='transition hover:text-secondary'>{site.email}</a>
        </li>
        <li class='flex items-center gap-3'>
          <Icon name='clock' class='h-4 w-4 shrink-0 text-primary-light' />
          <span>{site.hours}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class='border-t border-white/10'>
    <div class='mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-6 py-6 text-xs sm:flex-row'>
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>Crafted with care in Kolkata</p>
    </div>
  </div>
</footer>
