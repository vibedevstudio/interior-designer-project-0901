---
import Icon from './Icon.astro';
import { faqs } from '../data/site';
---

<section id='faq' class='bg-secondary/60 py-24'>
  <div class='mx-auto max-w-3xl px-6'>
    <div class='reveal mb-12 text-center'>
      <p class='mb-4 text-xs font-bold uppercase tracking-[0.3em] text-primary'>FAQ</p>
      <h2 class='font-display text-3xl text-neutral-900 md:text-4xl'>Answers, before you even ask</h2>
    </div>

    <div class='space-y-4'>
      {faqs.map((faq) => (
        <details class='reveal group rounded-2xl border border-neutral-200 bg-white transition open:border-primary/40 open:shadow-lg'>
          <summary class='flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-display text-lg text-neutral-900 [&::-webkit-details-marker]:hidden'>
            {faq.q}
            <span class='shrink-0 rounded-full bg-primary/10 p-1.5 text-primary transition-transform duration-300 group-open:rotate-45'>
              <Icon name='plus' class='h-5 w-5' />
            </span>
          </summary>
          <p class='px-6 pb-6 text-sm leading-relaxed text-neutral-600'>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
