---
import Icon from './Icon.astro';
import { site, stats, heroImage } from '../data/site';
---

<section id='home' class='relative flex min-h-screen items-center overflow-hidden'>
  <img src={heroImage} alt='Elegant living room designed by RT Interior Designer' class='absolute inset-0 h-full w-full object-cover animate-slow-zoom' loading='eager' fetchpriority='high' />
  <div class='absolute inset-0 bg-gradient-to-b from-primary-dark/70 via-primary-dark/50 to-neutral-900/80'></div>

  <div class='relative mx-auto w-full max-w-7xl px-6 py-32'>
    <p class='mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.3em] text-secondary animate-fade-in'>
      <span class='h-px w-10 bg-secondary'></span>
      Interior Design Studio - Kolkata
    </p>
    <h1 class='max-w-3xl font-display text-4xl leading-tight text-white md:text-6xl md:leading-tight animate-fade-up'>
      Homes that hold your story, designed with soul.
    </h1>
    <p class='mt-6 max-w-xl text-lg font-light leading-relaxed text-white/85 animate-fade-up' style='animation-delay: 0.15s'>
      {site.name} crafts bespoke residential and commercial interiors across Kolkata - from first sketch to final styling.
    </p>

    <div class='mt-10 flex flex-wrap items-center gap-4 animate-fade-up' style='animation-delay: 0.3s'>
      <a href='#contact' class='group inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 text-sm font-bold uppercase tracking-widest text-white shadow-xl transition hover:bg-primary-light'>
        Book a Free Consultation
        <Icon name='arrow-right' class='h-4 w-4 transition-transform group-hover:translate-x-1' />
      </a>
      <a href='#projects' class='inline-flex items-center gap-2 rounded-full border border-white/50 px-8 py-4 text-sm font-bold uppercase tracking-widest text-white backdrop-blur-sm transition hover:bg-white hover:text-primary-dark'>
        View Our Work
      </a>
    </div>

    <div class='mt-16 grid max-w-lg grid-cols-3 divide-x divide-white/20 animate-fade-up' style='animation-delay: 0.45s'>
      {stats.map((stat) => (
        <div class='px-5 first:pl-0'>
          <p class='font-display text-3xl text-secondary'>{stat.value}</p>
          <p class='mt-1 text-[11px] font-bold uppercase tracking-widest text-white/70'>{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
